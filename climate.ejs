
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dữ liệu ngập - WebGIS</title>
<link rel="stylesheet" href="/css/style.css">
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f7f9f8;color:#263238}.webgis{display:flex;min-height:100vh}
.sidebar{width:245px;min-width:245px;background:#176b45;color:white;display:flex;flex-direction:column;padding:24px 15px}
.logo{padding:5px 12px 30px;border-bottom:1px solid #ffffff30}.logo strong{display:block;font-size:15px;line-height:1.5;font-weight:bold}.sidebar-menu{margin-top:25px}
.menu-item,.sidebar-bottom a{display:flex;align-items:center;gap:12px;padding:12px 14px;margin-bottom:7px;color:#e5f4eb;text-decoration:none;border-radius:8px;font-size:13px}.menu-item:hover,.sidebar-bottom a:hover{background:#ffffff20;color:white}.menu-item.active{background:white;color:#176b45;font-weight:bold}.sidebar-bottom{margin-top:auto;padding-top:20px;border-top:1px solid #ffffff30}
.data-page{flex:1;min-width:0;padding:35px 42px;background:#f7f9f8;overflow-y:auto}.page-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}.page-title h1{margin:0 0 8px;font-size:25px;color:#19332a}.page-title p{margin:0;font-size:13px;color:#7a8580}
.search-box{width:250px;height:40px;background:white;border:1px solid #e1e7e3;border-radius:8px;display:flex;align-items:center;padding:0 12px;gap:8px}.search-box input{width:100%;border:0;outline:0;font-size:12px}
.data-card{background:white;border:1px solid #e4e9e6;border-radius:10px;overflow:hidden;box-shadow:0 2px 8px #00000008}.data-card-header{padding:18px 22px;border-bottom:1px solid #edf0ee}.data-card-header h2{margin:0;font-size:15px;color:#28483b}.data-card-header p{margin:5px 0 0;font-size:11px;color:#8a948f}.table-wrapper{overflow-x:auto}
table{width:100%;min-width:900px;border-collapse:collapse}th,td{padding:15px 14px;text-align:left;white-space:nowrap;border-bottom:1px solid #edf0ee}th{background:#f4f8f5;font-size:11px;color:#52635a}td{font-size:12px;color:#4b5651}tbody tr:hover{background:#f8fbf9}.code{color:#176b45;font-weight:bold}.depth{font-weight:600;color:#34483e}
.badge{display:inline-block;padding:5px 11px;border-radius:20px;font-size:10px;font-weight:bold}.low{background:#dff4e8;color:#17824d}.medium{background:#fff1c9;color:#b77900}.high{background:#ffe0df;color:#d92f2f}.table-footer{display:flex;justify-content:space-between;padding:14px 20px;color:#8a948f;font-size:11px}.data-count{color:#176b45;font-weight:bold}
@media(max-width:800px){.sidebar{width:210px;min-width:210px}.data-page{padding:25px 20px}.page-header{flex-direction:column;gap:18px}.search-box{width:100%}}
</style>
</head>
<body>
<div class="webgis">
<aside class="sidebar">
<div class="logo"><strong>Viện Phát triển Xã hội,Môi trường và Nông nghiệp</strong></div>
<nav class="sidebar-menu">
<a href="/dashboard" class="menu-item"><span>⌂</span>Trang chủ</a>
<a href="/map" class="menu-item"><span>🗺</span>Bản đồ</a>
<a href="/climate" class="menu-item active"><span>🌊</span>Dữ liệu ngập</a>
<a href="/warning" class="menu-item"><span>⚠</span>Cảnh báo</a>
<a href="/statistics" class="menu-item"><span>▥</span>Thống kê</a>
</nav>
<div class="sidebar-bottom"><a href="#"><span>ⓘ</span>Giới thiệu</a><a href="/"><span>↪</span>Đăng xuất</a></div>
</aside>
<main class="data-page">
<div class="page-header"><div class="page-title"><h1>Dữ liệu ngập</h1><p>Danh sách các điểm ngập và thông tin dữ liệu</p></div><div class="search-box">🔎<input id="searchInput" placeholder="Tìm kiếm..."></div></div>
<div class="data-card">
<div class="data-card-header"><h2>Danh sách điểm ngập</h2><p>Thông tin quan trắc và ghi nhận tình trạng ngập</p></div>
<div class="table-wrapper">
<table id="floodTable">
<thead><tr><th>Mã điểm</th><th>Tên điểm</th><th>Khu vực</th><th>Độ sâu ngập</th><th>Mức độ</th><th>Thời gian ghi nhận</th></tr></thead>
<tbody>
<% const data=[['NG001','Đ. Nguyễn Hữu Cảnh','Bình Thạnh','0.30 m','Trung bình','medium','22/06/2026 08:10'],['NG002','Đ. Lê Văn Lương','Quận 7','0.45 m','Cao','high','22/06/2026 08:15'],['NG003','Đ. Phạm Văn Đồng','TP. Thủ Đức','0.25 m','Trung bình','medium','22/06/2026 07:50'],['NG004','Đ. Quốc Hương','TP. Thủ Đức','0.60 m','Cao','high','22/06/2026 07:40'],['NG005','Đ. Âu Cơ','Tân Bình','0.20 m','Thấp','low','22/06/2026 07:20'],['NG006','Đ. Kinh Dương Vương','Bình Tân','0.50 m','Cao','high','22/06/2026 08:50'],['NG007','Đ. Điện Biên Phủ','Bình Thạnh','0.25 m','Thấp','low','22/06/2026 08:30'],['NG008','Đ. Huỳnh Tấn Phát','Quận 7','0.70 m','Rất cao','high','22/06/2026 09:05'],['NG009','Đ. Võ Văn Ngân','TP. Thủ Đức','0.40 m','Trung bình','medium','22/06/2026 08:45'],['NG010','Đ. Lạc Long Quân','Tân Bình','0.45 m','Trung bình','medium','22/06/2026 08:25']];%>
<%data.forEach(r=>{%><tr><td class="code"><%=r[0]%></td><td><%=r[1]%></td><td><%=r[2]%></td><td class="depth"><%=r[3]%></td><td><span class="badge <%=r[5]%>"><%=r[4]%></span></td><td><%=r[6]%></td></tr><%})%>
</tbody>
</table>
</div>
<div class="table-footer"><span>Hiển thị <b class="data-count" id="count">10</b> điểm ngập</span><span>Cập nhật: 22/06/2026</span></div>
</div>
</main>
</div>
<script>
const input=document.getElementById('searchInput'),rows=document.querySelectorAll('#floodTable tbody tr'),count=document.getElementById('count');
input.addEventListener('input',()=>{let n=0,k=input.value.toLowerCase();rows.forEach(r=>{let show=r.innerText.toLowerCase().includes(k);r.style.display=show?'':'none';if(show)n++});count.textContent=n});
</script>
</body>
</html>