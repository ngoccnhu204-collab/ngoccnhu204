<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dữ liệu ngập lụt</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="flood-container">

    <!-- ================= TIÊU ĐỀ ================= -->

    <div class="flood-title">

        <h1>🌧️ DỮ LIỆU NGẬP LỤT</h1>

        <p>
            Quản lý và tra cứu thông tin các điểm ngập tại TP. Hồ Chí Minh
        </p>

    </div>


    <!-- ================= BỘ LỌC ================= -->

    <div class="filter-card">

        <div class="filter-title">
            🔎 BỘ LỌC DỮ LIỆU
        </div>


        <div class="filter-body">

            <!-- Mã điểm ngập -->

            <div class="filter-item">

                <label>Mã điểm ngập</label>

                <select id="pointCode">
                    <option value="">Tất cả điểm</option>
                </select>

            </div>


            <!-- Khu vực -->

            <div class="filter-item">

                <label>Khu vực</label>

                <select id="area">
                    <option value="">Tất cả khu vực</option>
                </select>

            </div>


            <!-- Mức độ -->

            <div class="filter-item">

                <label>Mức độ ngập</label>

                <select id="level">

                    <option value="">Tất cả mức độ</option>

                    <option value="nhe">
                        Ngập nhẹ
                    </option>

                    <option value="vua">
                        Ngập trung bình
                    </option>

                    <option value="nghiemtrong">
                        Ngập nghiêm trọng
                    </option>

                </select>

            </div>


            <!-- Từ ngày -->

            <div class="filter-item">

                <label>Từ ngày</label>

                <input
                    type="date"
                    id="fromDate"
                >

            </div>


            <!-- Đến ngày -->

            <div class="filter-item">

                <label>Đến ngày</label>

                <input
                    type="date"
                    id="toDate"
                >

            </div>


            <!-- Nút -->

            <div class="filter-buttons">

                <button
                    class="btn-filter"
                    onclick="filterData()"
                >
                    🔎 Lọc dữ liệu
                </button>

                <button
                    class="btn-reset"
                    onclick="resetFilter()"
                >
                    ↻ Đặt lại
                </button>

            </div>

        </div>

    </div>


    <!-- ================= THỐNG KÊ ================= -->

    <div class="statistics">

        <!-- Điểm ngập -->

        <div class="stat-box">

            <div class="stat-icon blue-icon">
                🌊
            </div>

            <div class="stat-content">

                <span>Điểm ngập</span>

                <strong>--</strong>

            </div>

        </div>


        <!-- Độ sâu -->

        <div class="stat-box">

            <div class="stat-icon blue-icon">
                📏
            </div>

            <div class="stat-content">

                <span>Độ sâu trung bình</span>

                <strong>-- m</strong>

            </div>

        </div>


        <!-- Ngập nghiêm trọng -->

        <div class="stat-box">

            <div class="stat-icon blue-icon">
                ⚠️
            </div>

            <div class="stat-content">

                <span>Ngập nghiêm trọng</span>

                <strong>--</strong>

            </div>

        </div>


        <!-- Cập nhật -->

        <div class="stat-box">

            <div class="stat-icon blue-icon">
                🕘
            </div>

            <div class="stat-content">

                <span>Cập nhật gần nhất</span>

                <strong>--</strong>

            </div>

        </div>

    </div>


    <!-- ================= DANH SÁCH ================= -->

    <div class="data-card">

        <div class="data-header">

            <div>

                <h2>
                    🌧️ Danh sách điểm ngập
                </h2>

                <p>
                    Thông tin các điểm ngập được quản lý trong hệ thống
                </p>

            </div>


            <button
                class="btn-add"
                onclick="addFloodPoint()"
            >
                ＋ Thêm điểm ngập
            </button>

        </div>


        <!-- BẢNG -->

        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>STT</th>

                        <th>Mã điểm</th>

                        <th>Khu vực</th>

                        <th>Vị trí</th>

                        <th>Độ sâu ngập</th>

                        <th>Mức độ</th>

                        <th>Thời gian</th>

                        <th>Trạng thái</th>

                        <th>Thao tác</th>

                    </tr>

                </thead>


                <tbody id="floodTable">

                    <!-- Chưa có dữ liệu -->

                    <tr>

                        <td
                            colspan="9"
                            class="empty-data"
                        >

                            <div class="empty-icon">
                                🌧️
                            </div>

                            <strong>
                                Chưa có dữ liệu
                            </strong>

                            <p>
                                Hiện chưa có điểm ngập nào được cập nhật.
                            </p>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    // ==============================
    // LỌC DỮ LIỆU
    // ==============================

    function filterData() {

        alert(
            "Chức năng lọc sẽ được kết nối khi có dữ liệu."
        );

    }


    // ==============================
    // ĐẶT LẠI
    // ==============================

    function resetFilter() {

        document.getElementById("pointCode").value = "";

        document.getElementById("area").value = "";

        document.getElementById("level").value = "";

        document.getElementById("fromDate").value = "";

        document.getElementById("toDate").value = "";

    }


    // ==============================
    // THÊM ĐIỂM NGẬP
    // ==============================

    function addFloodPoint() {

        alert(
            "Chức năng thêm điểm ngập sẽ được thực hiện sau."
        );

    }

</script>

</body>
</html>