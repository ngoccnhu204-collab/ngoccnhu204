<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hạ tầng xanh - Climate Smart City</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- DÁN NAVBAR Ở ĐÂY -->
    <nav class="navbar">
        <div class="nav-container">

            <div class="nav-brand">
                🌍 Climate Smart City
            </div>

            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/dashboard" class="nav-link">
                        Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/climate" class="nav-link">
                        Dữ liệu khí hậu
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/hsng" class="nav-link active">
                        Hạ tầng xanh
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/logout" class="nav-link">
                        Đăng xuất
                    </a>
                </li>
            </ul>

        </div>
    </nav>

    <!-- Nội dung trang -->
    <div class="container">

        <h1>🌳 Hạ tầng xanh</h1>
<div class="card full-width">

    <h3>🌳 Danh sách khu vực cây xanh</h3>

    <table class="climate-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Tên khu vực</th>
                <th>Số cây</th>
                <th>Diện tích</th>
                <th>Loại cây</th>
                <th>Tỷ lệ che phủ</th>
                <th>Trạng thái</th>
            </tr>
        </thead>

        <tbody>

            <% data.forEach(item => { %>

            <tr>

                <td><%= item.id %></td>

                <td><%= item.name %></td>

                <td><%= item.trees %></td>

                <td><%= item.area %></td>

                <td><%= item.type %></td>

                <td><%= item.cover %>%</td>

                <td>
                    <span class="badge <%= item.status === 'Tốt' ? 'good' : 'moderate' %>">
                        <%= item.status %>
                    </span>
                </td>

            </tr>

            <% }); %>

        </tbody>

    </table>

</div>
        
