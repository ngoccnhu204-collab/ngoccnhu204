<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Thống kê ngập lụt</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="webgis">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            🌍 WebGIS
        </div>

        <nav class="menu">

            <a href="/" class="menu-item">
                🗺️
                <span>Bản đồ</span>
            </a>

            <a href="/canh-bao" class="menu-item">
                ⚠️
                <span>Cảnh báo</span>
            </a>

            <a href="/statistics" class="menu-item active">
                📊
                <span>Thống kê</span>
            </a>

        </nav>

    </aside>


    <!-- NỘI DUNG -->
    <main class="main-content">

        <div class="page-header">

            <h1>📊 Thống kê ngập lụt</h1>

            <p>
                Tổng hợp và thống kê tình hình ngập lụt
            </p>

        </div>


        <!-- 4 THẺ -->
        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-icon">🌊</div>

                <div class="stat-info">
                    <h3>Tổng điểm ngập</h3>
                    <strong>--</strong>
                    <p>Chưa có dữ liệu</p>
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-icon">⚠️</div>

                <div class="stat-info">
                    <h3>Điểm ngập mức cao</h3>
                    <strong>--</strong>
                    <p>Chưa có dữ liệu</p>
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-icon">📏</div>

                <div class="stat-info">
                    <h3>Độ sâu ngập TB</h3>
                    <strong>--</strong>
                    <p>Chưa có dữ liệu</p>
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-icon">🕒</div>

                <div class="stat-info">
                    <h3>Thời gian ngập TB</h3>
                    <strong>--</strong>
                    <p>Chưa có dữ liệu</p>
                </div>
            </div>

        </div>


        <!-- KHU VỰC BIỂU ĐỒ -->
        <div class="statistics-grid">

            <div class="data-card">

                <h2>📊 Thống kê theo khu vực</h2>

                <div class="empty-statistics">

                    <div class="empty-icon">
                        📊
                    </div>

                    <h3>Chưa có dữ liệu</h3>

                    <p>
                        Hiện chưa có dữ liệu để hiển thị biểu đồ.
                    </p>

                </div>

            </div>


            <div class="data-card">

                <h2>📈 Mức độ ngập</h2>

                <div class="empty-statistics">

                    <div class="empty-icon">
                        📈
                    </div>

                    <h3>Chưa có dữ liệu</h3>

                    <p>
                        Chưa có dữ liệu thống kê mức độ ngập.
                    </p>

                </div>

            </div>

        </div>


        <!-- BẢNG -->
        <div class="data-card">

            <h2>📋 Bảng thống kê chi tiết</h2>

            <div class="empty-table">

                <div class="table-icon">
                    📋
                </div>

                <h3>Chưa có dữ liệu</h3>

                <p>
                    Hiện chưa có dữ liệu thống kê để hiển thị.
                </p>

            </div>

        </div>

    </main>

</div>

</body>
</html>