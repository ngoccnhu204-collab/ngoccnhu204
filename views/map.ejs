
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Bản đồ ngập lụt - WebGIS TP.HCM</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/css/style.css">
<style>
*{box-sizing:border-box}
.map-page{flex:1;min-width:0;padding:35px 42px;background:#f7f9f8;min-height:100vh}
.map-page h1{color:#19332a;font-size:25px;margin:0 0 8px}
.map-page>p{color:#7a8580;font-size:13px;margin:0 0 28px}
.map-card{background:#fff;border:1px solid #e4e9e6;border-radius:10px;overflow:hidden;width:100%;box-shadow:0 2px 8px #00000008}
.map-head{padding:18px 22px;display:flex;justify-content:space-between;align-items:center}
.map-head h2{font-size:15px;color:#28483b;margin:0}
.map-head b{background:#dff4e8;color:#17824d;padding:7px 11px;border-radius:20px;font-size:11px}
.map-tools{display:flex!important;flex-direction:row!important;align-items:flex-end!important;gap:14px!important;flex-wrap:wrap!important;padding:18px 22px!important;background:#fff!important;border:0!important;border-top:1px solid #edf0ee!important;border-bottom:1px solid #edf0ee!important;width:100%!important;height:auto!important}
.map-tools h3{background:#176b45;color:#fff;padding:11px;margin:0;font-size:12px;border-radius:6px;white-space:nowrap}
.map-tools label{display:block;color:#52635a;font-size:11px;margin-bottom:5px}
.map-tools select,.map-tools input{width:170px;height:36px;padding:8px;border:1px solid #d7e1e2;border-radius:6px;background:#fff;font-size:12px}
.map-tools button{height:36px;padding:0 15px;border:0;border-radius:6px;background:#176b45;color:#fff;cursor:pointer;white-space:nowrap}
.map-wrap{height:570px!important;width:100%!important;position:relative!important;overflow:hidden!important}
#map{height:100%!important;width:100%!important}
.map-legend{display:flex!important;gap:22px;align-items:center;padding:15px 20px;background:#fff!important;border-top:1px solid #e8eeee!important;font-size:12px;color:#59696c;position:static!important;width:100%!important;height:auto!important}
.dot{display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:6px;vertical-align:middle}
.low{background:#35a87f}.mid{background:#f1ae35}.high{background:#e85b5b}
@media(max-width:1100px){
.map-tools{flex-wrap:wrap!important}
}
@media(max-width:900px){
.map-page{margin-left:0;padding:20px}
}
@media(max-width:600px){
.map-tools{display:grid!important;grid-template-columns:1fr!important}
.map-tools select,.map-tools input,.map-tools button{width:100%}
.map-wrap{height:600px!important}
.map-legend{flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="webgis">
<aside class="sidebar">
<div class="logo"><div class="logo-text">
<strong>Viện Phát triển Xã hội,</strong>
<strong>Môi trường và Nông nghiệp</strong>
</div></div>
<nav class="sidebar-menu">
<a href="/dashboard" class="menu-item"><span class="menu-icon">⌂</span><span>Trang chủ</span></a>
<a href="/map" class="menu-item active"><span class="menu-icon">🗺</span><span>Bản đồ</span></a>
<a href="/climate" class="menu-item"><span class="menu-icon">🌊</span><span>Dữ liệu ngập</span></a>
<a href="/warning" class="menu-item"><span class="menu-icon">⚠</span><span>Cảnh báo</span></a>
<a href="/statistics" class="menu-item"><span class="menu-icon">▥</span><span>Thống kê</span></a>
</nav>
<div class="sidebar-bottom">
<a href="#"><span>ⓘ</span>Giới thiệu</a><a href="/"><span>↪</span>Đăng xuất</a></div>
</aside>
<main class="map-page">
<h1>Bản đồ ngập lụt</h1>
<p>Theo dõi vị trí và mức độ ngập tại Thành phố Hồ Chí Minh</p>
<div class="map-card">
<div class="map-head">
<h2>🗺 Bản đồ các điểm ngập</h2>
<b>6 điểm ngập</b>
</div>
<div class="map-tools">
<h3>CÔNG CỤ QUẢN LÝ BẢN ĐỒ</h3>
<div><label>Khu vực</label>
<select id="district">
<option value="">Tất cả khu vực</option>
<option>Bình Thạnh</option>
<option>Quận 7</option>
<option>TP. Thủ Đức</option>
<option>Tân Bình</option>
<option>Bình Tân</option>
</select></div>

<div><label>Mức độ ngập</label>
<select id="level">
<option value="">Tất cả mức độ</option>
<option>Thấp</option>
<option>Trung bình</option>
<option>Cao</option>
</select></div>
<div><label>Tìm kiếm điểm ngập</label>
<input id="search" placeholder="Ví dụ: NG01">
</div>
<button id="reset">Đặt lại bộ lọc</button>
</div>
<div class="map-wrap">
<div id="map"></div>
</div>
<div class="map-legend">
<b>Mức độ ngập:</b>
<span><i class="dot low"></i>Thấp</span>
<span><i class="dot mid"></i>Trung bình</span>
<span><i class="dot high"></i>Cao</span>
</div>
</div>
</main>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const map=L.map('map').setView([10.8231,106.6297],11);
const road=L.tileLayer(
'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
{maxZoom:19,attribution:'© OpenStreetMap'}
);
const satellite=L.tileLayer(
'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
{maxZoom:19,attribution:'© Esri'}
);
satellite.addTo(map);
L.control.layers({
'🛰 Bản đồ vệ tinh':satellite,
'🗺 Bản đồ đường':road
}).addTo(map);
const points=[
['NG01','Đường Nguyễn Hữu Cảnh','Bình Thạnh',.3,'Trung bình',10.7885,106.7218],
['NG02','Đường Lê Văn Lương','Quận 7',.45,'Cao',10.7145,106.7058],
['NG03','Đường Phạm Văn Đồng','TP. Thủ Đức',.25,'Trung bình',10.8238,106.7575],
['NG04','Đường Quốc Hương','TP. Thủ Đức',.6,'Cao',10.8035,106.7355],
['NG05','Đường Âu Cơ','Tân Bình',.2,'Thấp',10.785,106.642],
['NG06','Đường Kinh Dương Vương','Bình Tân',.5,'Cao',10.753,106.605]
];
let markers=[];
const color=x=>x==='Cao'?'#e85b5b':x==='Trung bình'?'#f1ae35':'#35a87f';
function show(data){
markers.forEach(m=>map.removeLayer(m));
markers=data.map(p=>L.circleMarker([p[5],p[6]],{
radius:9,fillColor:color(p[4]),color:'#fff',
weight:2,fillOpacity:.9
}).bindPopup(`<b>${p[0]}</b><br>${p[1]}<br>Khu vực: ${p[2]}<br>Độ sâu: ${p[3]} m<br>Mức độ: ${p[4]}`).addTo(map));
}
function filter(){
let d=district.value,l=level.value,s=search.value.toLowerCase();
show(points.filter(p=>
(!d||p[2]===d)&&
(!l||p[4]===l)&&
(!s||p[0].toLowerCase().includes(s)||p[1].toLowerCase().includes(s))
));
}
function resetMap(){
district.value=level.value=search.value='';
show(points);
map.setView([10.8231,106.6297],11);
}
district.onchange=level.onchange=search.oninput=filter;
reset.onclick=resetMap;
show(points);
setTimeout(()=>map.invalidateSize(),300);
</script>
</body>
</html>