<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bản đồ ngập lụt TP.HCM - WebGIS</title>

    <!-- Leaflet -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="webgis">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="logo">
            🌊
            <span>WebGIS</span>
        </div>

        <div class="search-box">
            🔎
            <input type="text"
                   placeholder="Tìm kiếm khu vực...">
        </div>

        <nav class="sidebar-menu">

            <a href="/map" class="menu-item active">
                🗺️
                <span>Bản đồ</span>
            </a>

            <a href="/climate" class="menu-item">
                🌧️
                <span>Dữ liệu ngập</span>
            </a>

            <a href="/warning" class="menu-item">
                ⚠️
                <span>Cảnh báo</span>
            </a>

            <a href="/statistics" class="menu-item">
                📊
                <span>Thống kê</span>
            </a>

            <a href="/forecast" class="menu-item">
                🔮
                <span>Dự báo ngập</span>
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a href="/dashboard">
                🏠 Trang chủ
            </a>

            <a href="#">
                ℹ️ Giới thiệu
            </a>

        </div>

    </aside>


    <!-- =========================
         MAP AREA
    ========================== -->

    <main class="map-container">

        <div id="map"></div>


        <!-- TOP TITLE -->

        <div class="map-title-card">

            <div class="map-title-icon">
                🌊
            </div>

            <div>

                <h1>Bản đồ ngập lụt</h1>

                <p>
                    TP. Hồ Chí Minh
                </p>

            </div>

        </div>


        <!-- INFORMATION CARD -->

        <div class="weather-card">

            <div class="weather-header">

                <div>
                    <span class="weather-label">
                        THÔNG TIN HIỆN TẠI
                    </span>

                    <h2>
                        TP. Hồ Chí Minh
                    </h2>
                </div>

                <div class="weather-status">
                    ● Theo dõi
                </div>

            </div>


            <div class="weather-main">

                <div class="weather-icon">
                    🌧️
                </div>

                <div>

                    <div class="weather-temp">
                        --
                    </div>

                    <div class="weather-condition">
                        Chưa có dữ liệu
                    </div>

                </div>

            </div>


            <div class="weather-details">

                <div class="weather-detail">

                    <span>🌧️</span>

                    <div>
                        <small>Lượng mưa</small>
                        <strong>--</strong>
                    </div>

                </div>


                <div class="weather-detail">

                    <span>💧</span>

                    <div>
                        <small>Độ ẩm</small>
                        <strong>--</strong>
                    </div>

                </div>


                <div class="weather-detail">

                    <span>🌊</span>

                    <div>
                        <small>Mực nước</small>
                        <strong>--</strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- LEGEND -->

        <div class="legend">

            <h4>
                🌊 Độ sâu ngập
            </h4>

            <div class="legend-item">

                <span class="legend-color light"></span>

                <span>0 – 0.3 m</span>

            </div>


            <div class="legend-item">

                <span class="legend-color medium"></span>

                <span>0.3 – 0.5 m</span>

            </div>


            <div class="legend-item">

                <span class="legend-color high"></span>

                <span>0.5 – 1.0 m</span>

            </div>


            <div class="legend-item">

                <span class="legend-color severe"></span>

                <span>&gt; 1.0 m</span>

            </div>

        </div>


        <!-- MAP TOOLS -->

        <div class="map-tools">

            <button onclick="toggleFloodLayer()"
                    title="Hiển thị lớp ngập">
                🌊
            </button>

            <button onclick="map.zoomIn()"
                    title="Phóng to">
                +
            </button>

            <button onclick="map.zoomOut()"
                    title="Thu nhỏ">
                −
            </button>

            <button onclick="map.setView([10.8231,106.6297],11)"
                    title="Về TP.HCM">
                ⌖
            </button>

        </div>


        <!-- NO DATA NOTICE -->

        <div class="map-notice">

            <span>ℹ️</span>

            <div>
                <strong>Chưa có dữ liệu ngập</strong>

                <p>
                    Bản đồ sẽ hiển thị vùng ngập
                    khi có dữ liệu đầu vào.
                </p>
            </div>

        </div>

    </main>

</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    // =========================
    // KHỞI TẠO BẢN ĐỒ
    // =========================

    const map = L.map("map", {
        zoomControl: false
    }).setView(
        [10.8231, 106.6297],
        11
    );


    // =========================
    // OPENSTREETMAP
    // Không cần API KEY
    // =========================

    L.tileLayer(
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);
    setTimeout(() => {
    map.invalidateSize();
}, 500);

    // =========================
    // LỚP NGẬP
    // Hiện chưa có dữ liệu
    // =========================

    let floodVisible = false;


    function toggleFloodLayer() {

        floodVisible = !floodVisible;

        const notice =
            document.querySelector(".map-notice");

        if (floodVisible) {

            notice.classList.add("show");

        } else {

            notice.classList.remove("show");

        }

    }


    // =========================
    // FIX MAP SIZE
    // =========================

    setTimeout(() => {

        map.invalidateSize();

    }, 300);

</script>

</body>

</html>