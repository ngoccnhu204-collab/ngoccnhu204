    <div class="container">

        <h1>Climate Smart City Dashboard</h1>

        <p>Hệ thống WebGIS quản lý Climate Smart City.</p>

        <!-- 4 Card -->
        <div class="dashboard-grid">

            <div class="card">
                <h3>🌡️ Nhiệt độ</h3>
                <h2>26.5°C</h2>
                <p>Nhiệt độ trung bình</p>
            </div>

            <div class="card">
                <h3>🌧️ Lượng mưa</h3>
                <h2>180 mm</h2>
                <p>Hôm nay</p>
            </div>

            <div class="card">
                <h3>💧 Độ ẩm</h3>
                <h2>72%</h2>
                <p>Độ ẩm không khí</p>
            </div>

            <div class="card">
                <h3>🌬️ Tốc độ gió</h3>
                <h2>3.5 m/s</h2>
                <p>Gió trung bình</p>
            </div>
            <div class="card">
    <h3>🌳 Cây xanh đô thị</h3>
    <h2>12,450</h2>
    <p>Số lượng cây xanh</p>
</div>
<div class="stat-change">+230 cây mới</div>
        </div>

        </div>

        <div class="content-grid">

    <!-- Bản đồ -->
    <div class="box">

        <h2>🗺️ Bản đồ Climate Smart City</h2>

        <!-- Các nút điều khiển -->
        <div class="map-controls">

            <button class="btn" onclick="toggleLayer('temperature')">
                🌡️ Nhiệt độ
            </button>

            <button class="btn" onclick="toggleLayer('humidity')">
                💧 Độ ẩm
            </button>

            <button class="btn" onclick="toggleLayer('green')">
                🌳 Cây xanh
            </button>

        </div>
    <script>

function toggleLayer(type){

    if(type==="temperature"){
        alert("Đang hiển thị lớp Nhiệt độ");
    }

    if(type==="humidity"){
        alert("Đang hiển thị lớp Độ ẩm");
    }

    if(type==="green"){
        alert("Đang hiển thị lớp Cây xanh");
    }

}
</script>
</script>

        <!-- Bản đồ -->
        <div id="map"></div>

    </div>

    <!-- Biểu đồ -->
    <div class="box">

        <h2>📈 Thống kê lượng mưa</h2>

