<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đăng nhập - Climate Smart City</title>

    <link rel="stylesheet" href="/style.css">

</head>


<body>


<div class="login-container">

    <h2>🌍 Climate Smart City</h2>


    <form action="/login" method="POST">


        <div class="form-group">

            <label>
                Tên đăng nhập
            </label>

            <input 
            type="text"
            name="username"
            placeholder="admin"
            required>

        </div>



        <div class="form-group">

            <label>
                Mật khẩu
            </label>

            <input 
            type="password"
            name="password"
            placeholder="••••••••"
            required>

        </div>



        <% if(error){ %>

            <p style="color:red">
                <%= error %>
            </p>

        <% } %>



        <button class="login-btn" type="submit">
            Đăng nhập
        </button>


    </form>


    <p style="text-align:center;margin-top:20px">
        Demo: admin / climate2026
    </p>


</div>


</body>

</html>