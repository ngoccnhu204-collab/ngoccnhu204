<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cảnh báo ngập - WebGIS</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="webgis">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            🌊 WebGIS
        </div>

        <nav class="menu">

            <a href="/dashboard">
                🏠 Tổng quan
            </a>

            <a href="/map">
                🗺️ Bản đồ
            </a>

            <a href="/warning" class="active">
                ⚠️ Cảnh báo
            </a>

            <a href="/statistics">
                📊 Thống kê
            </a>

            <a href="/forecast">
                🌧️ Dự báo ngập
            </a>

        </nav>

    </aside>


    <!-- CONTENT -->
    <main class="main-content">

        <div class="page-header">
            <h1>⚠️ Cảnh báo ngập</h1>

            <p>
                Theo dõi tình hình và mức độ cảnh báo ngập tại TP.HCM
            </p>
        </div>


        <!-- WARNING CARD -->
        <div class="data-card">

            <h2>Tình trạng cảnh báo hiện tại</h2>

            <div class="warning-status">
                <div class="warning-icon">
                    ⚠️
                </div>

                <div>
                    <h3>Chưa có cảnh báo ngập</h3>

                    <p>
                        Hiện tại chưa ghi nhận khu vực có mức độ ngập
                        nghiêm trọng.
                    </p>
                </div>
            </div>

        </div>


        <!-- TABLE -->
        <div class="data-card">

            <h2>Danh sách khu vực cảnh báo</h2>

            <div class="empty-table">

                <div class="table-icon">
                    📋
                </div>

                <h3>Chưa có dữ liệu cảnh báo</h3>

                <p>
                    Dữ liệu cảnh báo ngập sẽ được cập nhật tại đây.
                </p>

            </div>

        </div>

    </main>

</div>

</body>
</html>